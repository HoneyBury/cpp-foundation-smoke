Checks: >
  -*,
  bugprone-*,
  clang-analyzer-*,
  concurrency-*,
  performance-*,
  portability-*,
  modernize-avoid-bind,
  modernize-loop-convert,
  modernize-make-unique,
  modernize-use-nullptr
WarningsAsErrors: >
  bugprone-*,
  clang-analyzer-*,
  concurrency-*,
  performance-*,
  portability-*
HeaderFilterRegex: '^(include|src|tests|fuzz)/'
FormatStyle: file
